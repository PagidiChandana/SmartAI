# Copy to .env and fill values. Never commit .env
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/studyai
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
NODE_ENV=development
AUTH_COOKIE_NAME=studyai_token
# Cross-site cookies (Vercel frontend + Render backend are different origins,
# so the browser only sends the auth cookie with SameSite=None + Secure):
# dev default (same-host): COOKIE_SAMESITE=lax, COOKIE_SECURE unset/false.
# production split-origin: COOKIE_SAMESITE=none, COOKIE_SECURE=true.
#COOKIE_SAMESITE=lax
#COOKIE_SECURE=false
RESET_TOKEN_MINUTES=30

# AI provider: "openai" | "gemini" | "ollama" | "mock" (default mock, no key needed)
# - openai/gemini: set AI_PROVIDER plus the matching API key below (keys stay
#   server-side; never commit .env, never expose keys to the browser).
# - ollama (free, local, no key): install Ollama from https://ollama.com,
#   run `ollama pull llama3.1` once, keep `ollama serve` running, then set:
#     AI_PROVIDER=ollama
#     OLLAMA_MODEL=llama3.1
#   The tutor, planner, drafting and insights then use real local AI.
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1

# Admin seeding ONLY via CLI (never a public endpoint):
# ADMIN_EMAIL=admin@studyai.local ADMIN_PASSWORD=StrongPass123 npm run seed:admin
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=StudyAI Admin
# Super admin bootstrap ONLY via CLI (never a public endpoint, min 12 chars).
# Safe to re-run: existing super admins are never demoted; the password is
# only reset when SUPER_ADMIN_RESET_PASSWORD=true.
# SUPER_ADMIN_EMAIL=root@studyai.local SUPER_ADMIN_PASSWORD=LongRandomPass123 npm run seed:superadmin
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_NAME=Super Admin
# SUPER_ADMIN_RESET_PASSWORD=false

# Resource file storage: local disk in development (server/uploads/resources).
# Production should use a cloud provider (e.g. STORAGE_PROVIDER=s3 + credentials).
STORAGE_PROVIDER=local

# AI tutor knobs (credentials stay in OPENAI_API_KEY / GEMINI_API_KEY above)
TUTOR_TIMEOUT_MS=60000
TUTOR_MAX_QUESTION=2000
TUTOR_HISTORY=10
# Retrieval: keyword (lexical baseline; NOT vector search). Vector only when implemented + configured.
RETRIEVER=keyword
# VECTOR_DB_URL=

# Web Push is NOT integrated. To enable it you must provide VAPID keys,
# register a service worker in the client, and wire a push provider.
# Until then POST /api/notifications/push/subscribe returns 501.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@example.com
